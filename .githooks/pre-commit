#!/bin/sh
# Pre-commit quality gate for PositiveFPS (versioned in .githooks/; enable with: python tools/install_hooks.py).
#
# For commits that touch code (*.gd, *.tscn, *.tres, project.godot, tools/*, tests/*) it runs tools/gate.py --hook:
#   1. tools/lint.py                (gdformat --check and gdlint)
#   2. tools/run_tests.py --tier fast: every test under 5 s plus the slow tests that the staged scripts' changed functions
#      (or a changed tests/*_test.gd) can reach, chosen from the saved coverage map (tools/fast_tier.py); everything when
#      it cannot tell (config.gd, scenes, project.godot, the test tooling, no or old map).
#   and, only when coverage_baseline.json is staged, tools/coverage.py --check-baseline instead of step 2 (the same
#   tests run instrumented, and the line coverage ratchet is checked; a saved clean run of the same code is reused).
# A commit whose staged paths cannot change a Godot test (docs, tools other than run_tests/gate/coverage/godot_run/
# godot_path/fast_tier) runs lint and the changed tools' own tools/test_*.py self-checks only.
# If the working tree is byte-for-byte what already passed the gate, the gate says so and returns at once (the result
# cache in .git/positivefps-gate-cache.json; see tools/gate.py; a fast pass never answers a full request).
# Agents must run `python tools/gate.py --full` at the end of every round: the ratchet is not part of every commit.
# Other commits are not checked. Commits that only touch design/ or Markdown docs skip the gate (tools/hook_paths.sh).
#
# Known limitation: lint and tests run on the working tree, not on the staged snapshot. Unstaged edits
# therefore count too. Stash them first if you need the staged version tested exactly.
#
# Never bypass this with --no-verify; fix the cause instead.

cd "$(git rev-parse --show-toplevel)" || exit 1
PYTHON="${PYTHON:-python}"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
. tools/hook_paths.sh

# SOURCE_MAP.md must match the GDScript (cheap: reads the files, no Godot). Checked whenever a .gd file is staged,
# or SOURCE_MAP.md itself is, so it also runs before the docs-only skip below.
if printf '%s
' "$staged" | grep -Eq '\.gd$|^SOURCE_MAP\.md$'; then
  "$PYTHON" tools/source_map.py --check || exit 1
fi

if printf '%s
' "$staged" | is_docs_only; then
  echo "pre-commit: design/docs-only change, skipping tests"
  exit 0
fi
if ! printf '%s
' "$staged" | needs_gate; then
  echo "pre-commit: no code changes, skipping tests"
  exit 0
fi

exec "$PYTHON" tools/gate.py --hook --label pre-commit
