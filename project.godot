; Engine configuration file.
config_version=5

[application]

config/name="PositiveFPS"
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.7")
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

; Every mesh that uses the styled toon shader (it has `instance uniform`s) reserves 16 vec4 of this buffer, hidden or not.
; The default 65536 holds 4096 meshes, and a styled game needs about 4400 once every block has built its whimsical
; version (tests/shader_instances_test.gd counts it). 262144 vec4 (4 MiB) holds 16384, about twice the worst case.
limits/global_shader_variables/buffer_size=262144

[debug]

gdscript/warnings/exclude_addons=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/return_value_discarded=0

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")
