shader_type spatial;
render_mode cull_back, specular_disabled;
#include "res://common.gdshaderinc"

varying vec3 wpos;
void vertex() { wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz; }

void fragment() {
	vec2 p = wpos.xz;
	vec2 g = p * 1.0;
	g.x += mod(floor(g.y), 2.0) * 0.5;
	vec2 id = floor(g);
	vec2 f = fract(g);
	float h = hash21(id);
	float h2 = hash21(id + 17.3);
	float e = min(min(f.x, 1.0 - f.x), min(f.y, 1.0 - f.y));
	float fade = (PROJECTION_MATRIX[3][3] > 0.5) ? 0.0 : smoothstep(10.0, 34.0, length(VERTEX));
	float stone = mix(smoothstep(0.05, 0.12, e), 0.9, fade);
	float dome = mix(0.88 + 0.2 * smoothstep(0.05, 0.32, e), 1.0, fade);

	// grey world
	vec3 gc = mix(S(vec3(0.46, 0.51, 0.59)), S(vec3(0.55, 0.60, 0.68)), h);
	float soot = vnoise(p * 0.8 + 5.0);
	gc *= 1.0 - 0.32 * smoothstep(0.35, 0.8, soot);
	float mud = smoothstep(0.58, 0.78, vnoise(p * 0.33));
	gc = mix(gc, S(vec3(0.30, 0.24, 0.19)), mud * 0.6);
	gc = mix(gc, S(vec3(0.46, 0.30, 0.20)), step(0.93, h2) * 0.5);
	gc = mix(S(vec3(0.27, 0.29, 0.33)), gc * dome, stone);

	// warm world
	vec3 wc = mix(S(vec3(0.82, 0.70, 0.53)), S(vec3(0.72, 0.56, 0.43)), h);
	wc = mix(wc, S(vec3(0.82, 0.55, 0.42)), step(0.8, h2) * 0.5);
	wc = mix(wc, S(vec3(0.93, 0.85, 0.66)), step(0.9, h) * 0.6);
	float moss = smoothstep(0.55, 0.78, vnoise(p * 0.45 + 9.0));
	vec3 mossc = S(vec3(0.50, 0.62, 0.38));
	wc = mix(wc, mossc, moss * 0.55);
	vec3 mort = mix(S(vec3(0.52, 0.40, 0.31)), S(vec3(0.45, 0.56, 0.33)), 0.6 * smoothstep(0.35, 0.7, vnoise(p * 1.3)));
	wc = mix(mort, wc * dome, stone);
	// tiny flowers
	vec2 fc = f - vec2(0.5);
	float fl = step(length(fc), 0.1) * step(0.945, h2) * (1.0 - fade);
	vec3 fcol = h > 0.66 ? S(vec3(0.86, 0.42, 0.42)) : (h > 0.33 ? S(vec3(0.93, 0.74, 0.30)) : S(vec3(0.95, 0.90, 0.78)));
	wc = mix(wc, fcol, fl);

	float m = joy_field(p);
	float joy = joy_dither(m, FRAGCOORD.xy);
	gc = sand_ridges(gc, joy_field_smooth(p), p, FRAGCOORD.xy);
	float rim = smoothstep(0.0, 0.5, m) * (1.0 - smoothstep(0.5, 1.3, m));
	wc += S(vec3(0.20, 0.14, 0.05)) * rim * 0.5;
	ALBEDO = mix(gc, wc, joy);
	ROUGHNESS = 1.0;
}
